# Copy to .env.local and fill in. Never commit .env.local.

# DeepSeek — main model (deepseek-flash) and Search/Fetch tools
DEEPSEEK_API_KEY=

# OpenRouter — second provider (optional until the key is issued)
OPENROUTER_API_KEY=

# Kimi (Moonshot) — second provider for the model-switch demo (D-23)
MOONSHOT_API_KEY=

# Overrides (optional)
# VAULT_DIR=./demo-vault          # vault root; default ./demo-vault
# MODEL_PROVIDER=openrouter       # override `active` in 90_配置/模型.md
